# Environments and tools (recreated from pixi.toml and patches/)
.pixi/
third_party/
__pycache__/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.vscode/

# Scratch folders at the repo root only (kaggle/outputs/**/runs/ stays tracked)
/data/
/runs/
/outputs/

# Code bundle uploaded to Kaggle, rebuilt on every run
vitok-code.zip

# Raw FineWeb-2 data: vitok.data downloads it again
*.parquet

# Kaggle outputs: keep logs and JSON results, drop duplicates and binaries
# (each run's copy of its tokenizer duplicates kaggle/outputs/vitok-data/tokenizers-16k/)
kaggle/outputs/results-*/runs/*/tokenizer/
# final checkpoints, downloaded from the notebook outputs for local evaluation
kaggle/outputs/results-*/runs/*/base_checkpoints/
# binary tensors (token_bytes.pt, checkpoints)
*.pt
*.safetensors
